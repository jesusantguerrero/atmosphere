{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:jesusantguerrero/atmosphere-core.git"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-mailparse": "*",
        "brick/money": "^0.10",
        
        "dompdf/dompdf": "^2.0.3",
        "ernysans/laraworld": "^1.0",
        "freesgen/atmosphere": "dev-inertia-v2-compat",
        "google/apiclient": "^2.12",
        "guzzlehttp/guzzle": "^7.0.2",
        "inertiajs/inertia-laravel": "^3.3",
        "insane/journal": "dev-master@dev",
        "insane/plan-module": "dev-master",
        "insane/treasurer": "dev-laravel-13",
        "insane/watchlist-module": "dev-laravel-13",
        "joshbrw/laravel-module-installer": "^2.0",
        "lab404/laravel-impersonate": "^1.7",
        "laravel/framework": "^13.0",
        "laravel/jetstream": "^5.0",
        "laravel/pulse": "^1.0@beta",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "maatwebsite/excel": "^3.1",
        "mvanduijker/laravel-mercure-broadcaster": "^3.5",
        "nwidart/laravel-modules": "*",
        "php-mime-mail-parser/php-mime-mail-parser": "^8.0",
        "phpoffice/phpspreadsheet": "^1.27",
        "rlanvin/php-rrule": "^2.4",
        "simshaun/recurr": "^5.0",
        "smalot/pdfparser": "*",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-navigation": "^1.2",
        "spatie/laravel-onboard": "^2.4",
        "spatie/laravel-typescript-transformer": "^2.3",
        "staudenmeir/belongs-to-through": "^2.17",
        "symfony/dom-crawler": "^7.0",
        "tightenco/ziggy": "^1.5.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "brianium/paratest": "^7.8",
        "fakerphp/faker": "^1.9.1",
        "insane/remotr": "dev-main",
        "laravel/boost": "^2.5",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.0",
        "spatie/laravel-ignition": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Google\\Task\\Composer::cleanup",
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "composer install --prefer-dist --no-interaction --no-scripts --no-progress --no-ansi --ignore-platform-reqs",
            "composer dump-autoload",
            "composer install --prefer-dist --no-interaction --no-scripts --no-suggest --no-progress --no-ansi --ignore-platform-reqs"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "google/apiclient-services": [
            "Gmail",
            "Oauth2"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "process-timeout": 0,
        "allow-plugins": {
            "joshbrw/laravel-module-installer": true,
            "wikimedia/composer-merge-plugin": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
